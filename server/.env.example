# ---------------------------------------------------------------------------
# Universal Business Platform API - environment
# ---------------------------------------------------------------------------
# IMPORTANT: use the LIMITED role (app_api), never the database owner.
# The password for app_api is the one you set when creating the role.
NEON_DATABASE_URL=postgresql://app_api:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string (e.g. openssl rand -hex 32). Never commit the real value.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

PORT=4000
# Comma separated list of allowed browser origins
CORS_ORIGINS=https://your-app.example.com,http://localhost:5173
