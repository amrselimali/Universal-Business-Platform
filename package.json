{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/emit-screen-budget.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:size": "node scripts/check-file-size.mjs",
    "guardrails": "node scripts/architecture-guardrails.mjs",
    "guardrails:check": "node scripts/architecture-guardrails.mjs --check",
    "guardrails:update": "node scripts/architecture-guardrails.mjs --update",
    "budget:bundle": "node scripts/check-bundle-budget.mjs && node scripts/emit-screen-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test && npm run check:size && npm run guardrails:check && npm run build && npm run context:freeze && npm run screens:check && npm run budget:bundle",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "perf:api": "k6 run perf/api-budget.js",
    "screens:update": "node scripts/screen-metrics.mjs --update",
    "screens:check": "node scripts/screen-metrics.mjs --check",
    "context:freeze": "node scripts/check-context-freeze.mjs",
    "seed:invoices": "node scripts/seed-million-invoices.mjs",
    "invoice:p95": "node scripts/measure-invoices-p95.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.4"
  }
}
