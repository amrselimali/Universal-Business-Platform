@inherits ComponentBase

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(IsEdit ? T.T("common.edit") : T.T("common.add"))</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                @if (Kind == PartnerKind.Customer)
                {
                    <MudTextField Value="@CodeDisplay" Label="@T.T("common.code")" ReadOnly="true"
                                  Variant="Variant.Outlined" MaxLength="50"
                                  HelperText="@T.T("common.auto_generated")" />
                }
                else
                {
                    <MudTextField @bind-Value="_input.Code" Label="@T.T("common.code")" Required="true" Variant="Variant.Outlined" MaxLength="50" />
                }
                <MudSelect T="Guid?" @bind-Value="_input.CategoryId" Label="@T.T("partners.category")" Variant="Variant.Outlined"
                           Clearable="true" Required="@(Kind == PartnerKind.Customer)">
                    @foreach (var category in _categories)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">@CategoryName(category)</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_input.NameAr" Label="@T.T("common.name_ar")" Required="true" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_input.NameEn" Label="@T.T("common.name_en")" Variant="Variant.Outlined" />
                <MudSelect T="string" Value="_input.ScopeType" Label="@T.T("partners.scope")"
                           Variant="Variant.Outlined" ValueChanged="OnScopeChanged">
                    @if (_canUseCompanyScope)
                    {
                        <MudSelectItem Value="@("COMPANY")">@T.T("partners.scope_company")</MudSelectItem>
                    }
                    <MudSelectItem Value="@("BRANCH")">@T.T("partners.scope_branch")</MudSelectItem>
                </MudSelect>
                @if (_input.ScopeType == "BRANCH")
                {
                    <MudSelect T="Guid?" Value="_input.BranchId" Label="@T.T("common.branch")"
                               Variant="Variant.Outlined" Required="true" ValueChanged="OnBranchChanged">
                        @foreach (var branch in _branches)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)branch.Id)">@branch.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudTextField @bind-Value="_input.Phone" Label="@T.T("common.phone")"
                              Variant="Variant.Outlined" Required="@(Kind == PartnerKind.Customer)" />
                <MudTextField @bind-Value="_input.Phone2" Label="@T.T("partners.phone2")" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_input.WhatsAppPhone"
                              Label="@T.T("partners.whatsapp_phone")" Variant="Variant.Outlined"
                              Required="@(Kind == PartnerKind.Customer)" MaxLength="50" />
                <MudText Typo="Typo.caption" Class="ubp-muted ubp-span-2">
                    @T.T("partners.whatsapp_phone_hint")
                </MudText>
                <MudTextField @bind-Value="_input.Email" Label="@T.T("partners.email")" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_input.TaxNumber" Label="@T.T("partners.tax_number")" Variant="Variant.Outlined" />
                <MudNumericField T="decimal" @bind-Value="_input.CreditLimit" Label="@T.T("partners.credit_limit")" Variant="Variant.Outlined" Min="0m" />
                <MudTextField @bind-Value="_input.Address" Label="@T.T("common.address")" Variant="Variant.Outlined" Class="ubp-span-2" />
                <MudTextField @bind-Value="_input.Notes" Label="@T.T("common.notes")" Variant="Variant.Outlined" Lines="2" Class="ubp-span-2" />
                <MudSwitch @bind-Value="_input.IsActive" Label="@T.T("common.active")" Color="Color.Success" />
            </div>

            @if (Kind == PartnerKind.Customer && !IsEdit)
            {
                <MudDivider Class="my-4" />
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.subtitle2">@T.T("partners.opening_balances")</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddBalanceAsync">
                        @T.T("partners.add_opening_balance")
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="ubp-muted d-block mb-2">
                    @T.T("partners.opening_balances_hint")
                </MudText>
                @if (_balances.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="ubp-muted">
                        @T.T("partners.no_opening_balances")
                    </MudText>
                }
                else
                {
                    <MudTable Items="_balances" Dense="true" Elevation="0" Class="ubp-table">
                        <HeaderContent>
                            <MudTh>@T.T("partners.service")</MudTh>
                            <MudTh Align="Right">@T.T("common.quantity")</MudTh>
                            <MudTh Align="Right">@T.T("inventory.unit_price")</MudTh>
                            <MudTh Align="Right">@T.T("accounting.total")</MudTh>
                            <MudTh Align="Right">@T.T("partners.paid")</MudTh>
                            <MudTh Align="Right">@T.T("partners.remaining")</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudAutocomplete T="ItemOption" Value="context.Service"
                                                 SearchFunc="SearchServices" ToStringFunc="ServiceLabel"
                                                 ValueChanged="@(v => OnServiceChanged(context, v))"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 ResetValueOnEmptyText="true" CoerceValue="true"
                                                 Placeholder="@T.T("partners.service")" />
                            </MudTd>
                            <MudTd Align="Right">
                                <MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0.01m"
                                                 Format="N2" Margin="Margin.Dense"
                                                 Variant="Variant.Outlined" />
                            </MudTd>
                            <MudTd Align="Right">
                                <MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0m"
                                                 Format="N2" Margin="Margin.Dense"
                                                 Variant="Variant.Outlined" />
                            </MudTd>
                            <MudTd Align="Right">@context.Total.ToString("N2")</MudTd>
                            <MudTd Align="Right">
                                <MudNumericField T="decimal" @bind-Value="context.Paid" Min="0m"
                                                 Format="N2" Margin="Margin.Dense"
                                                 Variant="Variant.Outlined" />
                            </MudTd>
                            <MudTd Align="Right">@context.Remaining.ToString("N2")</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               OnClick="@(() => RemoveBalance(context))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }

            @if (_fields.Count > 0)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">@T.T("custom_fields.title")</MudText>
                <div class="ubp-form-grid">
                    @foreach (var field in _fields)
                    {
                        var key = field.FieldKey;
                        if (field.DataType == "bool")
                        {
                            <MudCheckBox T="bool" Value="@GetBool(key)" Label="@Label(field)"
                                         ValueChanged="@(v => SetBool(key, v))" />
                        }
                        else if (field.DataType == "list")
                        {
                            <MudSelect T="string" Value="@Get(key)" Label="@Label(field)"
                                       Variant="Variant.Outlined" ValueChanged="@(v => Set(key, v))">
                                @foreach (var option in field.Options)
                                {
                                    <MudSelectItem Value="@option">@option</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudTextField T="string" Value="@Get(key)" Label="@Label(field)"
                                          Variant="Variant.Outlined" ValueChanged="@(v => Set(key, v))" />
                        }
                    }
                </div>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>
