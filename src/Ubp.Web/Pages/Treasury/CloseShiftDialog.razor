@using TreasuryModel = Ubp.Core.Models.Treasury
@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @T.T("treasury.shift_report") — @Shift.Code — @T.T("treasury.opened_at"):
            @Shift.OpenedAt.ToString("yyyy-MM-dd HH:mm") — @T.T("treasury.closed_at"):
            @(Shift.ClosedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—") — @Shift.Username —
            @Shift.BranchName
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_report is null)
        {
            <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
        }
        else
        {
            <ShiftReportView @ref="_view" Report="_report" Editable="@(CanEdit)" />
        }

        @if (_settlement is { RequiresDecision: true })
        {
            <MudPaper Outlined="true" Class="pa-3 mt-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">تسوية شفت الدكتور الخارجى</MudText>
                <MudText Typo="Typo.body2">
                    العميل: <b>@_settlement.CustomerName</b> — الإيرادات:
                    <b>@_settlement.Revenues.ToString("N2")</b> — التحصيلات:
                    <b>@_settlement.Collections.ToString("N2")</b> — قيمة التسوية:
                    <b>@_settlement.Amount.ToString("N2")</b>
                </MudText>
                <MudSelect T="string" Value="_settlementMode" Label="طريقة التسوية"
                           Variant="Variant.Outlined" Class="mt-2"
                           ValueChanged="OnSettlementModeChanged">
                    <MudSelectItem T="string" Value="@ShiftSettlementModes.Doctor">
                        تحميل الكل على حساب الدكتور الخارجى
                    </MudSelectItem>
                    <MudSelectItem T="string" Value="@ShiftSettlementModes.Treasury">
                        سداد الكل من خزينة
                    </MudSelectItem>
                    <MudSelectItem T="string" Value="@ShiftSettlementModes.Mixed">
                        جزء من خزينة والباقى على حساب الدكتور
                    </MudSelectItem>
                </MudSelect>
                @if (_settlementMode is ShiftSettlementModes.Treasury or ShiftSettlementModes.Mixed)
                {
                    <MudSelect T="Guid?" Value="_settlementTreasuryId" Label="الخزينة"
                               Variant="Variant.Outlined" Required="true" Class="mt-2"
                               ValueChanged="OnSettlementTreasuryChanged">
                        @foreach (var treasury in _settlementTreasuries)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)treasury.Id)">
                                @treasury.Code — @treasury.NameAr
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="decimal" @bind-Value="_settlementTreasuryAmount"
                                     Label="المسدد من الخزينة" Min="0m"
                                     Max="@Math.Abs(_settlement.Amount)" Format="N2"
                                     Variant="Variant.Outlined" Class="mt-2"
                                     Disabled="@(_settlementMode == ShiftSettlementModes.Treasury)" />
                    <MudText Typo="Typo.caption" Class="ubp-muted d-block mt-1">
                        المتبقى على حساب الدكتور: @SettlementDoctorPart.ToString("N2")
                    </MudText>
                }
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        @if (_canEditShift && _report is not null)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditAsync"
                       Disabled="_busy">@T.T("treasury.edit_shift_data")</MudButton>
        }
        <MudButton OnClick="Cancel" Disabled="_busy">
            @T.T(ReadOnly || !Shift.IsOpen ? "common.close" : "common.cancel")
        </MudButton>
        @if (CanEdit)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAsync"
                       Disabled="@(_busy || _report is null)">@T.T("treasury.close_shift")</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Shift Shift { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }

    [Inject] private TreasuryService Treasury { get; set; } = default!;
    [Inject] private LookupService Lookup { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private PermissionService Permissions { get; set; } = default!;
    [Inject] private IDialogService Dialogs { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private ShiftReport? _report;
    private ShiftReportView? _view;
    private bool _busy;
    private bool _canEditShift;
    private ExternalDoctorSettlementPreview? _settlement;
    private IReadOnlyList<TreasuryModel> _settlementTreasuries = Array.Empty<TreasuryModel>();
    private string? _settlementMode;
    private Guid? _settlementTreasuryId;
    private decimal _settlementTreasuryAmount;
    private decimal SettlementDoctorPart => _settlement is null ? 0m
        : Math.Max(Math.Round(Math.Abs(_settlement.Amount) - _settlementTreasuryAmount, 2,
            MidpointRounding.AwayFromZero), 0m);

    // العرض والإغلاق كلاهما يسمح بإدخال النقد المعدود/الملاحظات/القراءات للشفت المفتوح.
    private bool CanEdit => Shift.IsOpen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var actor = await UserContext.RequireAsync();
            // زر «تعديل بيانات الشفت»: صلاحية الشفتات أو صلاحية تعديل خدمة منفذة.
            _canEditShift = await Permissions.HasAsync(actor, ScreenCodes.TreasuryShifts,
                ActionCodes.Edit)
                || await Permissions.HasAsync(actor, ScreenCodes.Reservations,
                    ActionCodes.EditExecuted);
            _report = await Treasury.GetShiftReportAsync(actor, Shift.Id);
            if (Shift.IsExternalDoctor)
            {
                _settlement = await Treasury.GetExternalDoctorSettlementAsync(actor, Shift.Id);
                _settlementTreasuries = await Lookup.TreasuriesAsync(actor, Shift.BranchId);
                _settlementTreasuryId = _settlementTreasuries.FirstOrDefault()?.Id;
            }
            if (CanEdit)
                foreach (var row in _report.CashCounts)
                    row.CountedCash ??= row.ExpectedCash;
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
    }

    private async Task OpenEditAsync()
    {
        var dialog = await Dialogs.ShowAsync<ShiftEditDialog>(T.T("treasury.edit_shift_data"),
            new DialogParameters
            {
                ["ShiftId"] = Shift.Id, ["BranchId"] = Shift.BranchId
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false })
        {
            var actor = await UserContext.RequireAsync();
            _report = await Treasury.GetShiftReportAsync(actor, Shift.Id);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnSettlementModeChanged(string? mode)
    {
        _settlementMode = mode;
        if (_settlement is null) return;
        _settlementTreasuryAmount = mode == ShiftSettlementModes.Treasury
            ? Math.Abs(_settlement.Amount)
            : mode == ShiftSettlementModes.Doctor ? 0m : _settlementTreasuryAmount;
    }

    private void OnSettlementTreasuryChanged(Guid? treasuryId)
    {
        _settlementTreasuryId = treasuryId;
        _settlementTreasuryAmount = _settlementMode == ShiftSettlementModes.Treasury &&
                                    _settlement is not null
            ? Math.Abs(_settlement.Amount) : _settlementTreasuryAmount;
    }

    private async Task ConfirmAsync()
    {
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var counts = _report!.CashCounts
                .Select(c => new ShiftCashCountInput
                {
                    TreasuryId = c.TreasuryId, CountedCash = c.CountedCash ?? c.ExpectedCash
                })
                .ToList();
            ShiftSettlementInput? settlement = null;
            if (_settlement is { RequiresDecision: true })
            {
                if (string.IsNullOrWhiteSpace(_settlementMode))
                {
                    Snackbar.Add("اختر طريقة تسوية شفت الدكتور الخارجى قبل الإقفال.", Severity.Warning);
                    return;
                }
                if (_settlementMode is ShiftSettlementModes.Treasury or ShiftSettlementModes.Mixed
                    && _settlementTreasuryId is null)
                {
                    Snackbar.Add("اختر الخزينة التى سيتم السداد منها.", Severity.Warning);
                    return;
                }
                settlement = new ShiftSettlementInput
                {
                    Mode = _settlementMode,
                    TreasuryId = _settlementMode == ShiftSettlementModes.Doctor
                        ? null : _settlementTreasuryId,
                    TreasuryAmount = _settlementMode == ShiftSettlementModes.Doctor
                        ? 0m : _settlementTreasuryAmount
                };
            }
            var closed = await Treasury.CloseShiftAsync(actor, Shift.Id, counts, settlement);
            MudDialog.Close(DialogResult.Ok(closed));
        }
        catch (AppException ex) { Snackbar.Add(ErrorText(ex), Severity.Error); }
        finally { _busy = false; }
    }

    private string ErrorText(AppException ex)
    {
        var text = T.T(ex.Code);
        foreach (var arg in ex.Args)
            text = text.Replace("{" + arg.Key + "}", arg.Value);
        return text;
    }
}
