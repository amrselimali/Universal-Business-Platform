@page "/sales/reservations"
@attribute [Authorize]
@inherits SecurePageBase
@inject ReservationService ReservationsApi
@inject IDisplayFormatter Fmt
<PageTitle>@T.T("screen.reservations")</PageTitle>

@if (Denied)
{
    <ForbiddenView />
}
else if (Loading)
{
    <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <PageHeader Title="@T.T("screen.reservations")" Subtitle="@T.T("reservations.hint")" />

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="d-flex flex-wrap align-center gap-2 mb-3">
            <MudTextField @bind-Value="_customerSearch" Label="@T.T("reservations.customer_search")"
                          Placeholder="@T.T("reservations.customer_search_hint")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          DebounceInterval="350" OnDebounceIntervalElapsed="RefreshAsync"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Class="ubp-search" />
            <MudSwitch T="bool" Value="_onlyRemaining" ValueChanged="OnRemainingChanged"
                       Label="@T.T("reservations.only_remaining")" Color="Color.Primary" />
            <MudSwitch T="bool" Value="_openOnly" ValueChanged="OnOpenOnlyChanged"
                       Label="@T.T("reservations.open_only")" Color="Color.Primary" />
            @if (_branches.Count > 1)
            {
                <MudSelect T="Guid" MultiSelection="true" SelectedValues="_branchIds"
                           SelectedValuesChanged="OnBranchesChanged"
                           Label="@T.T("common.branch")" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Style="min-width:240px"
                           SelectAll="true" SelectAllValue="AllBranchesSelected">
                    @foreach (var branch in _branches)
                    {
                        <MudSelectItem T="Guid" Value="@branch.Id">@branch.NameAr</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (Can(ActionCodes.ExtendReservation))
            {
                <MudDatePicker @bind-Date="_extendTo" Label="@T.T("reservations.extend_to")"
                               Variant="Variant.Outlined" Class="ubp-date" />
            }
            <MudButton Variant="Variant.Text" OnClick="RefreshAsync">@T.T("common.refresh")</MudButton>
        </div>

        <MudTable T="ReservationRow" @ref="_table" ServerData="LoadAsync" Dense="true" Hover="true"
                  Breakpoint="Breakpoint.Md" SelectedItemChanged="OnSelected">
            <HeaderContent>
                <MudTh>@T.T("reservations.booking")</MudTh>
                <MudTh>@T.T("settlement.booking_date")</MudTh>
                <MudTh>@T.T("sales.booking_notes")</MudTh>
                <MudTh>@T.T("reservations.customer")</MudTh>
                <MudTh>@T.T("reservations.item")</MudTh>
                <MudTh>@T.T("reservations.reserved")</MudTh>
                <MudTh>@T.T("reservations.consumed")</MudTh>
                <MudTh>@T.T("reservations.remaining")</MudTh>
                <MudTh>@T.T("reservations.remaining_value")</MudTh>
                <MudTh Align="Right">@T.T("settlement.paid_value")</MudTh>
                <MudTh Align="Right">@T.T("settlement.due_on_customer")</MudTh>
                <MudTh>@T.T("sales.offer_expiry")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.BookingNo</MudTd>
                <MudTd>@context.BookingDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.BookingNotes) ? "—" : context.BookingNotes)</MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd>@context.ItemCode — @context.ItemName</MudTd>
                <MudTd>@Fmt.Decimal(context.ReservedQty)</MudTd>
                <MudTd>@Fmt.Decimal(context.ConsumedQty)</MudTd>
                <MudTd><strong>@Fmt.Decimal(context.RemainingQty)</strong></MudTd>
                <MudTd>@Fmt.Decimal(context.RemainingValue)</MudTd>
                <MudTd Align="Right">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               Disabled="@(context.PaidAmount <= 0)"
                               OnClick="@(() => ShowPaymentsAsync(context))">
                        @context.PaidAmount.ToString("N2")
                    </MudButton>
                </MudTd>
                <MudTd Align="Right">@context.UncollectedValue.ToString("N2")</MudTd>
                <MudTd>@(context.ExpiresAt is null ? "—" : Fmt.Date(context.ExpiresAt))</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                               Disabled="@(_busy || context.RemainingQty <= 0 || !Can(ActionCodes.Execute))"
                               OnClick="@(() => ExecuteAsync(context))">@T.T("reservations.execute")</MudButton>
                    @if (Can(ActionCodes.ExtendReservation))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                   Disabled="@(_busy)"
                                   OnClick="@(() => ExtendAsync(context))">@T.T("reservations.extend")</MudButton>
                    }
                    @if (Can(ActionCodes.SettleAccount))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                   Disabled="@(_busy || context.RemainingQty <= 0)"
                                   OnClick="@(() => SettleAsync(context))">@T.T("reservations.settle")</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}
