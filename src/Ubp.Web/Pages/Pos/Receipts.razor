@page "/pos/receipts"
@attribute [Authorize]
@inherits SecurePageBase
@inject PosService Pos
@inject BranchService Branches
@inject IDialogService Dialogs
@inject PermissionService Permissions
<PageTitle>@T.T("screen.pos_receipts")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.pos_receipts")" Subtitle="@T.T("pos.receipts_hint")" />

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudSelect T="Guid?" Value="_branchId" Label="@T.T("common.branch")"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       ToStringFunc="@BranchLabel" ValueChanged="OnBranchChanged">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)branch.Id)">@branch.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_search" Label="@T.T("sales.customer_search")"
                          Placeholder="@T.T("sales.customer_search_hint")" Immediate="true"
                          DebounceInterval="400" OnDebounceIntervalElapsed="OnSearchAsync"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudDatePicker Date="_from" Label="@T.T("common.from_date")"
                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd"
                           Editable="true" DateChanged="OnFromChanged" />
            <MudDatePicker Date="_to" Label="@T.T("common.to_date")"
                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd"
                           Editable="true" DateChanged="OnToChanged" />
        </div>

        <MudTable Items="_items" Dense="true" Hover="true" Striped="true" Elevation="0"
                  RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("sales.customer")</MudTh>
                <MudTh>@T.T("treasury.treasury")</MudTh>
                <MudTh>@T.T("pos.receipt_description")</MudTh>
                <MudTh>@T.T("sales.booking_notes")</MudTh>
                <MudTh Align="Right">@T.T("pos.receipt_value")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DocDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.PartyName</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.TreasuryName) ? "—" : context.TreasuryName)</MudTd>
                <MudTd Class="ubp-receipt-desc">
                    @(string.IsNullOrWhiteSpace(context.Description) ? "—" : context.Description)
                </MudTd>
                <MudTd>
                    @(string.IsNullOrWhiteSpace(context.Notes) ? "—" : context.Notes)
                </MudTd>
                <MudTd Align="Right">@context.Total.ToString("N2")</MudTd>
                <MudTd Align="Right">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Title="@T.T("pos.view_receipt")" Color="Color.Primary"
                                   OnClick="@(() => ViewAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small"
                                   Title="@T.T("pos.send_whatsapp")" Color="Color.Success"
                                   OnClick="@(() => SendWhatsAppAsync(context))" />
                    @if (_canEdit && !context.IsReversed &&
                         context.ReceiptType != VoucherReceiptTypes.Reversal &&
                         context.ReceiptType != VoucherReceiptTypes.Advance &&
                         !context.IsSettlementReceipt && context.Status != "cancelled")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Title="تعديل الإيصال" Color="Color.Warning"
                                       OnClick="@(() => EditAsync(context))" />
                    }
                    @if (_canDelete && !context.IsReversed &&
                         context.ReceiptType != VoucherReceiptTypes.Reversal &&
                         !context.IsSettlementReceipt && context.Status != "cancelled")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Title="@T.T("pos.delete_receipt")" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="ubp-muted pa-4">@T.T("common.no_records")</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50 }"
                               RowsPerPageString="@T.T("common.rows_per_page")" />
            </PagerContent>
        </MudTable>

        <MudText Typo="Typo.body2" Class="pa-4">
            @T.T("accounting.total"): <b>@_items.Sum(i => i.Total).ToString("N2")</b>
        </MudText>
    </MudPaper>
}

@code {
    private IReadOnlyList<CommercialDocument> _items = Array.Empty<CommercialDocument>();
    private IReadOnlyList<Branch> _branches = Array.Empty<Branch>();
    private Guid? _branchId;
    private string? _search;
    private DateTime? _from = DateTime.Today;
    private DateTime? _to = DateTime.Today;
    private bool _canEdit;
    private bool _canDelete;

    protected override string ScreenCode => ScreenCodes.PosReceipts;

    protected override async Task OnLoadAsync()
    {
        _branches = await Branches.OptionsAsync(Actor!);
        _branchId = Actor!.CurrentBranchId ?? _branches.FirstOrDefault()?.Id;
        _canEdit = await Permissions.HasAsync(Actor!, ScreenCodes.PosReceipts,
            ActionCodes.EditReceipt);
        _canDelete = await Permissions.HasAsync(Actor!, ScreenCodes.PosReceipts,
            ActionCodes.Delete) || _canEdit;
        await ReloadAsync();
    }

    private async Task ReloadAsync() =>
        _items = await Pos.ListReceiptsAsync(Actor!, _branchId, _from, _to, 500, _search);

    private Task OnBranchChanged(Guid? value) { _branchId = value; return RunAsync(ReloadAsync); }
    private Task OnSearchAsync(string? value)
    {
        _search = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        return RunAsync(ReloadAsync);
    }
    private Task OnFromChanged(DateTime? value) { _from = value; return RunAsync(ReloadAsync); }
    private Task OnToChanged(DateTime? value) { _to = value; return RunAsync(ReloadAsync); }
    private string BranchLabel(Guid? id) =>
        id is null ? "—" : _branches.FirstOrDefault(b => b.Id == id)?.NameAr ?? "—";

    private async Task ViewAsync(CommercialDocument doc) =>
        await Dialogs.ShowAsync<ViewReceiptDialog>(T.T("pos.view_receipt"),
            new DialogParameters { ["VoucherId"] = doc.Id });

    private async Task EditAsync(CommercialDocument doc)
    {
        var dialog = await Dialogs.ShowAsync<ReceiptEditDialog>("تعديل إيصال POS",
            new DialogParameters { ["VoucherId"] = doc.Id },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false })
        {
            await ReloadAsync();
            ShowSuccess("common.saved");
        }
    }

    private async Task SendWhatsAppAsync(CommercialDocument doc) => await RunAsync(async () =>
    {
        var sent = await Pos.SendReceiptWhatsAppAsync(Actor!, doc.Id);
        Snackbar.Add(T.T(sent ? "pos.whatsapp_queued" : "pos.whatsapp_unavailable"),
            sent ? Severity.Success : Severity.Warning);
    });

    /// <summary>
    /// حذف الإيصال: المسودة تُحذف فعليًا، والمُرحّل يُعكس بإيصال عكسي (تبقى القيود سليمة)
    /// وتُرجع مدفوعات الحجز فيظهر المبلغ غير المسدد من جديد.
    /// </summary>
    private async Task DeleteAsync(CommercialDocument doc)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(T.T("pos.delete_receipt"),
            $"{doc.PartyName} — {doc.Total:N2}: {T.T("pos.delete_receipt_confirm")}",
            yesText: T.T("pos.delete_receipt"), cancelText: T.T("common.cancel"));
        if (confirmed != true) return;

        await RunAsync(async () =>
        {
            var outcome = await Pos.DeleteReceiptAsync(Actor!, doc.Id);
            await ReloadAsync();
            Snackbar.Add(T.T(outcome.MessageKey), Severity.Success);
        });
    }
}
