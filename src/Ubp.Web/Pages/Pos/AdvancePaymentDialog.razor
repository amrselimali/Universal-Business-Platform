@using TreasuryModel = Ubp.Core.Models.Treasury
@using Ubp.Core.Results
@inject BookingCollectionService Collections
@inject UserContext UserContext
@inject UiCulture T
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">دفعة مقدمة — @CustomerName</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            دفعة مقدمة بلا خدمة محجوزة داخل شفت الدكتور الخارجى (تُرَحَّل ضمن دفعات العملاء المقدمة).
            الخزينة هي طريقة الدفع، وعمولة التحصيل تُحسب تلقائيًا من إعدادات الخزينة مثل الإيصال العادي.
        </MudAlert>
        <div class="ubp-form-grid">
            <MudNumericField T="decimal" Value="_amount" ValueChanged="OnAmountChanged"
                             Label="مبلغ الدفعة" Min="0.01m" Format="N2"
                             Variant="Variant.Outlined" />
            <MudSelect T="Guid?" Value="_treasuryId" Label="الخزينة"
                       Variant="Variant.Outlined" ValueChanged="OnTreasuryChanged">
                @foreach (var treasury in Treasuries)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)treasury.Id)">
                        @treasury.NameAr
                        (@treasury.CollectionFeePercent.ToString("N2")%)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="decimal" Value="_fee" Label="@T.T("pos.treasury_fee")"
                             Format="N2" Variant="Variant.Outlined" ReadOnly="true" />
            <MudNumericField T="decimal" Value="_net" Label="@T.T("pos.net_paid")"
                             Format="N2" Variant="Variant.Outlined" ReadOnly="true" />
            <MudTextField @bind-Value="_notes" Label="ملاحظات" Variant="Variant.Outlined"
                          MaxLength="500" Class="ubp-span-2" />
        </div>

        @if (_amount > 0 && SelectedTreasury is { } preview)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">@T.T("pos.receipt_preview")</MudText>
            <div class="pos-receipt">
                <div class="pos-receipt-head">
                    <div><b>@T.T("pos.receipt_no"): —</b></div>
                    <div>@T.T("sales.customer"): <b>@CustomerName</b></div>
                    <div>@T.T("treasury.treasury"): @preview.NameAr</div>
                </div>
                <div class="pos-receipt-totals">
                    <div><span>مبلغ الدفعة</span><span>@(_amount - _fee).ToString("N2")</span></div>
                    <div><span>@T.T("pos.treasury_fee")</span><span>@_fee.ToString("N2")</span></div>
                    <div><b>@T.T("pos.grand_due")</b><b>@_amount.ToString("N2")</b></div>
                    <div><span>@T.T("pos.paid_amount")</span><span>@_amount.ToString("N2")</span></div>
                    <div><span>@T.T("pos.remaining")</span><span>@(0m.ToString("N2"))</span></div>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="@(_busy || _amount <= 0 || _treasuryId is null || _net <= 0)">
            @T.T("common.save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid BranchId { get; set; }
    [Parameter] public Guid CustomerId { get; set; }
    [Parameter] public string? CustomerName { get; set; }
    [Parameter] public IReadOnlyList<TreasuryModel> Treasuries { get; set; } =
        Array.Empty<TreasuryModel>();

    private decimal _amount;
    private decimal _fee;
    private decimal _net;
    private Guid? _treasuryId;
    private string? _notes;
    private bool _busy;

    protected override void OnInitialized()
    {
        _treasuryId = Treasuries.FirstOrDefault()?.Id;
        Recalculate();
    }

    private TreasuryModel? SelectedTreasury =>
        Treasuries.FirstOrDefault(t => t.Id == _treasuryId);

    private void OnTreasuryChanged(Guid? treasuryId)
    {
        _treasuryId = treasuryId;
        Recalculate();
    }

    private void OnAmountChanged(decimal amount)
    {
        _amount = amount;
        Recalculate();
    }

    /// <summary>
    /// عمولة الخزينة وصافي المسدد بنفس معادلة الإيصال العادي (نسبة الخزينة من إجمالي المدفوع).
    /// </summary>
    private void Recalculate()
    {
        _fee = TreasuryFeeRules.CollectionFee(_amount,
            SelectedTreasury?.CollectionFeePercent ?? 0);
        _net = TreasuryFeeRules.Net(_amount, _fee);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_treasuryId is null || _amount <= 0 || _net <= 0) return;
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var result = await Collections.CollectAdvanceAsync(actor, new AdvancePaymentInput
            {
                BranchId = BranchId, CustomerId = CustomerId, TreasuryId = _treasuryId.Value,
                Amount = _amount, Notes = _notes
            });
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
