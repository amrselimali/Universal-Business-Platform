<MudPaper Elevation="0" Class="ubp-card" Hidden="@(Report is null && !Running)">
    @if (Running)
    {
        <div class="ubp-loading"><MudProgressCircular Indeterminate="true" />
            <MudText Class="mt-2">@T.T("qa.live_running")</MudText></div>
    }
    else if (Report is null)
    {
        <div class="ubp-empty">@T.T("qa.live_not_run")</div>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mb-2">@T.T("qa.live_title")</MudText>
        <MudAlert Severity="@IsolationSeverity" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            @(Report.IsolationVerified
                ? string.Format(T.T("qa.live_isolation_ok"), Report.QaDatabase)
                : T.T("qa.isolation_note"))
        </MudAlert>

        <div class="ubp-stats mb-3">
            <div class="ubp-stat"><MudIcon Icon="@ScoreIcon" />
                <div><span>@T.T("qa.live_score")</span><strong>@Report.HealthScore (@Report.Grade)</strong></div></div>
            <div class="ubp-stat"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                <div><span>@T.T("qa.live_tests")</span><strong>@Report.PassedTests / @Report.Tests.Count</strong></div></div>
            <div class="ubp-stat"><MudIcon Icon="@Icons.Material.Filled.Error" />
                <div><span>@T.T("qa.live_critical")</span><strong>@Report.CriticalCount</strong></div></div>
            <div class="ubp-stat"><MudIcon Icon="@Icons.Material.Filled.Warning" />
                <div><span>@T.T("qa.live_high")</span><strong>@Report.HighCount</strong></div></div>
            <div class="ubp-stat"><MudIcon Icon="@Icons.Material.Filled.Timer" />
                <div><span>@T.T("qa.live_duration")</span><strong>@Report.DurationMs.ToString("N0") ms</strong></div></div>
            <div class="ubp-stat"><MudIcon Icon="@Icons.Material.Filled.Storage" />
                <div><span>@T.T("qa.live_database")</span><strong class="ubp-small">@Report.Database</strong></div></div>
        </div>

        <MudText Typo="Typo.subtitle1" Class="mb-2">@T.T("qa.live_tests_title")</MudText>
        <MudTable Items="Report.Tests" Dense="true" Hover="true" Elevation="0" Class="ubp-table mb-4">
            <HeaderContent>
                <MudTh>@T.T("qa.code")</MudTh>
                <MudTh>@T.T("qa.test")</MudTh>
                <MudTh>@T.T("qa.category")</MudTh>
                <MudTh>@T.T("qa.live_severity")</MudTh>
                <MudTh>@T.T("qa.status")</MudTh>
                <MudTh>@T.T("qa.duration")</MudTh>
                <MudTh>@T.T("qa.message")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><span class="ubp-code">@context.Code</span></MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Category</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                               Color="@SeverityColor(context.Criticality)">@context.Criticality</MudChip></MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                               Color="@StatusColor(context.Status)">@context.Status</MudChip></MudTd>
                <MudTd>@(context.DurationMs > 0 ? $"{context.DurationMs} ms" : "—")</MudTd>
                <MudTd><span class="ubp-small">@context.Message</span></MudTd>
            </RowTemplate>
        </MudTable>

        <MudText Typo="Typo.subtitle1" Class="mb-2">@T.T("qa.live_findings")
            (@Report.Findings.Count)</MudText>
        @if (Report.Findings.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                @T.T("qa.live_clean")</MudAlert>
        }
        else
        {
            <MudTable Items="Report.Findings" Dense="true" Hover="true" Elevation="0" Class="ubp-table">
                <HeaderContent>
                    <MudTh>@T.T("qa.live_area")</MudTh>
                    <MudTh>@T.T("qa.live_severity")</MudTh>
                    <MudTh>@T.T("qa.live_issue")</MudTh>
                    <MudTh>@T.T("qa.live_metric")</MudTh>
                    <MudTh>@T.T("qa.live_suggestion")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Area</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                   Color="@SeverityColor(context.Severity)">@context.Severity</MudChip></MudTd>
                    <MudTd>@context.Title<div class="ubp-small ubp-muted">@context.Detail</div></MudTd>
                    <MudTd><span class="ubp-small">@context.Metric</span></MudTd>
                    <MudTd><span class="ubp-small">@context.Suggestion</span></MudTd>
                </RowTemplate>
            </MudTable>
        }

        <QaResourcesPanel Report="Report" />
        <QaTablesPanel Report="Report" />
    }
</MudPaper>
