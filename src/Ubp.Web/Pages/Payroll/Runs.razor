@page "/payroll/runs"
@attribute [Authorize]
@inherits SecurePageBase
@inject PayrollRunService PayrollRuns
@inject PayrollRunCalculationService PayrollCalculation
@inject PayrollPostingService PayrollPosting
@inject ISnackbar Snackbar

<PageTitle>دورات المرتبات</PageTitle>

@if (Denied)
{
	<ForbiddenView />
}
else if (Loading)
{
	<div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
	<PageHeader Title="دورات المرتبات" Subtitle="إنشاء دورة جديدة وإدارتها عبر مراحل الاعتماد" />

	<MudPaper Elevation="0" Class="ubp-card">
		<MudGrid>
			<MudItem xs="12" md="3"><MudTextField @bind-Value="_salaryFrom" Label="بداية المرتب" Variant="Variant.Outlined" /></MudItem>
			<MudItem xs="12" md="3"><MudTextField @bind-Value="_salaryTo" Label="نهاية المرتب" Variant="Variant.Outlined" /></MudItem>
			<MudItem xs="12" md="3"><MudTextField @bind-Value="_variablesFrom" Label="بداية المتغيرات" Variant="Variant.Outlined" /></MudItem>
			<MudItem xs="12" md="3"><MudTextField @bind-Value="_variablesTo" Label="نهاية المتغيرات" Variant="Variant.Outlined" /></MudItem>
			<MudItem xs="12" md="3"><MudDatePicker T="DateTime?" Label="قطع البيانات (Cutoff)" @bind-Date="_cutoff" DateFormat="yyyy-MM-dd HH:mm" /></MudItem>
			<MudItem xs="12" Class="d-flex" Style="gap:8px">
				<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">إنشاء دورة مسودة</MudButton>
				<MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CreateAdjustmentAsync"
						   Disabled="_creatingAdjustment">إنشاء دورة تسوية (Adjustment Run)</MudButton>
			</MudItem>
		</MudGrid>

		@if (_createdRun is not null)
		{
			<MudAlert Severity="Severity.Success" Class="mt-4">
				تم إنشاء الدورة @(_createdRun.Id) بالحالة: @_createdRun.Status
			</MudAlert>
		}
	</MudPaper>

	<MudPaper Elevation="0" Class="ubp-card mt-4">
		<MudText Typo="Typo.h6" Class="mb-3">الدورات السابقة</MudText>
		<MudTable Items="_runs" Dense="true" Hover="true" Striped="true">
			<HeaderContent>
				<MudTh>النوع</MudTh>
				<MudTh>الفترة</MudTh>
				<MudTh>المتغيرات</MudTh>
				<MudTh>الحالة</MudTh>
				<MudTh>الإصدار</MudTh>
				<MudTh>حساب</MudTh>
				<MudTh>النتائج</MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd>@(PayrollRunTypes.IsAdjustment(context.RunType) ? "تسوية" : "عادية")</MudTd>
				<MudTd>@context.SalaryFrom - @context.SalaryTo</MudTd>
				<MudTd>@context.VariablesFrom - @context.VariablesTo</MudTd>
				<MudTd>@context.Status</MudTd>
				<MudTd>@context.Version</MudTd>
				<MudTd>
					<MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
							   Disabled="@(context.Status != PayrollRunStatuses.Draft || _calculating)"
							   OnClick="@(() => CalculateRunAsync(context))">حساب</MudButton>
				</MudTd>
				<MudTd>
					<MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SelectRunAsync(context))">النتائج</MudButton>
				</MudTd>
			</RowTemplate>
		</MudTable>
	</MudPaper>

	@if (_selectedRun is not null)
	{
		<MudPaper Elevation="0" Class="ubp-card mt-4">
			<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
				<MudText Typo="Typo.h6">نتائج الدورة: @_selectedRun.SalaryFrom - @_selectedRun.SalaryTo</MudText>
				<MudStack Row="true" Spacing="1">
					@if (_selectedRun.Status == PayrollRunStatuses.Calculated)
					{
						<MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" OnClick="@(() => TransitionAsync(PayrollRunStatuses.UnderReview))">إرسال للمراجعة</MudButton>
					}
					@if (_selectedRun.Status == PayrollRunStatuses.UnderReview)
					{
						<MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => TransitionAsync(PayrollRunStatuses.Approved))">اعتماد</MudButton>
					}
					@if (_selectedRun.Status == PayrollRunStatuses.Approved)
					{
						<MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" OnClick="PostAsync">ترحيل</MudButton>
					}
					@if (_selectedRun.Status == PayrollRunStatuses.Posted)
					{
						<MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="PayAsync">صرف المرتبات</MudButton>
					}
				</MudStack>
			</MudStack>

			<MudTable Items="_results" Dense="true" Hover="true" Striped="true">
				<HeaderContent>
					<MudTh>الموظف</MudTh>
					<MudTh>العملة</MudTh>
					<MudTh>الإجمالي</MudTh>
					<MudTh>الخصومات</MudTh>
					<MudTh>الصافي</MudTh>
					<MudTh>الإصدار</MudTh>
					<MudTh></MudTh>
				</HeaderContent>
				<RowTemplate>
					<MudTd>@context.EmployeeId</MudTd>
					<MudTd>@context.CurrencyCode</MudTd>
					<MudTd>@context.GrossAmount.ToString("N2")</MudTd>
					<MudTd>@context.DeductionsAmount.ToString("N2")</MudTd>
					<MudTd>@context.NetAmount.ToString("N2")</MudTd>
					<MudTd>@context.CalculationVersion</MudTd>
					<MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SelectResultAsync(context))">التفاصيل</MudButton></MudTd>
				</RowTemplate>
			</MudTable>

			@if (_selectedRun.Status is PayrollRunStatuses.Posted or PayrollRunStatuses.Paid or PayrollRunStatuses.Closed)
			{
				<MudPaper Elevation="0" Class="ubp-card mt-4">
					<MudText Typo="Typo.subtitle2" Class="mb-2">إعادة فتح الدورة (صلاحية مستقلة + سبب)</MudText>
					<MudGrid>
						<MudItem xs="12" md="8"><MudTextField @bind-Value="_reopenReason" Label="سبب إعادة الفتح" Variant="Variant.Outlined" /></MudItem>
						<MudItem xs="12" md="4"><MudButton OnClick="ReopenAsync" Color="Color.Warning" Variant="Variant.Filled" FullWidth="true">إعادة فتح</MudButton></MudItem>
					</MudGrid>
				</MudPaper>
			}

			@if (_selectedRun.Status is PayrollRunStatuses.Posted or PayrollRunStatuses.PartiallyPaid)
			{
				<MudPaper Elevation="0" Class="ubp-card mt-4">
					<MudText Typo="Typo.subtitle2" Class="mb-2">صرف جزئي / مقسّم لموظف</MudText>
					<MudGrid>
						<MudItem xs="12" md="5">
							<MudSelect T="Guid?" Label="الموظف" @bind-Value="_payEmployeeId" Variant="Variant.Outlined">
								@foreach (var result in _results)
								{ <MudSelectItem T="Guid?" Value="@result.EmployeeId">@result.EmployeeId — @result.NetAmount.ToString("N2")</MudSelectItem> }
							</MudSelect>
						</MudItem>
						<MudItem xs="12" md="3">
							<MudSelect T="string" Label="الوسيلة" @bind-Value="_payMethod" Variant="Variant.Outlined">
								<MudSelectItem T="string" Value="@("bank_transfer")">تحويل بنكي</MudSelectItem>
								<MudSelectItem T="string" Value="@("cash")">نقدي</MudSelectItem>
								<MudSelectItem T="string" Value="@("cheque")">شيك</MudSelectItem>
							</MudSelect>
						</MudItem>
						<MudItem xs="12" md="2"><MudNumericField @bind-Value="_payAmount" Label="المبلغ (0=المتبقي)" Min="0" Variant="Variant.Outlined" /></MudItem>
						<MudItem xs="12" md="2"><MudButton OnClick="PayEmployeeAsync" Color="Color.Success" Variant="Variant.Filled" FullWidth="true">صرف</MudButton></MudItem>
					</MudGrid>
				</MudPaper>
			}


			@if (_issues.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">ملاحظات الدورة (@_issues.Count)</MudText>
				<MudTable Items="_issues" Dense="true">
					<HeaderContent><MudTh>الخطورة</MudTh><MudTh>الكود</MudTh><MudTh>الرسالة</MudTh><MudTh>تجاوز</MudTh></HeaderContent>
					<RowTemplate>
						<MudTd>@context.Severity</MudTd><MudTd>@context.Code</MudTd><MudTd>@context.Message</MudTd><MudTd>@(context.IsOverridden ? "نعم" : "لا")</MudTd>
					</RowTemplate>
				</MudTable>
			}
			@if (_stats is { Total: > 0 })
			{
				<MudStack Row="true" Spacing="2" Class="mt-4">
					<MudChip T="string" Size="Size.Small" Color="Color.Default">إجمالي: @_stats.Total</MudChip>
					<MudChip T="string" Size="Size.Small" Color="Color.Success">محسوب: @_stats.Calculated</MudChip>
					<MudChip T="string" Size="Size.Small" Color="Color.Error">فاشل: @_stats.Failed</MudChip>
					<MudChip T="string" Size="Size.Small" Color="Color.Warning">مستبعد: @_stats.Skipped</MudChip>
					<MudChip T="string" Size="Size.Small" Color="Color.Info">معلق: @_stats.Pending</MudChip>
				</MudStack>
				<MudTable Items="_runEmployees" Dense="true" Class="mt-2">
					<HeaderContent><MudTh>الموظف</MudTh><MudTh>الحالة</MudTh><MudTh>المحاولات</MudTh><MudTh>كود الخطأ</MudTh><MudTh>إصدار المحرك</MudTh></HeaderContent>
					<RowTemplate>
						<MudTd>@context.EmployeeId</MudTd><MudTd>@context.CalculationStatus</MudTd>
						<MudTd>@context.Attempts</MudTd><MudTd>@context.ErrorCode</MudTd>
						<MudTd>@context.EngineVersion</MudTd>
					</RowTemplate>
				</MudTable>
			}

			@if (_selectedRun.Status == PayrollRunStatuses.Paid)
			{
				<MudAlert Severity="Severity.Success" Class="mt-3">تم صرف الدورة للموظفين المسجلين.</MudAlert>
			}

			@if (_selectedResult is not null)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">تفاصيل الموظف @_selectedResult.EmployeeId</MudText>
				<MudTable Items="_details" Dense="true">
					<HeaderContent>
						<MudTh>البند</MudTh>
						<MudTh>المبلغ</MudTh>
						<MudTh>المعادلة</MudTh>
					</HeaderContent>
					<RowTemplate>
						<MudTd>@context.ItemCode</MudTd>
						<MudTd>@context.Amount.ToString("N2")</MudTd>
						<MudTd>@context.FormulaReference</MudTd>
					</RowTemplate>
				</MudTable>
			}
		</MudPaper>
	}
}

@code {
	private string _salaryFrom = DateTime.Today.ToString("yyyy-MM-dd");
	private string _salaryTo = DateTime.Today.ToString("yyyy-MM-dd");
	private string _variablesFrom = DateTime.Today.ToString("yyyy-MM-dd");
	private string _variablesTo = DateTime.Today.ToString("yyyy-MM-dd");
	private DateTime? _cutoff;
	private PayrollRun? _createdRun;
	private bool _creatingAdjustment;
	private IReadOnlyList<PayrollRun> _runs = Array.Empty<PayrollRun>();
	private IReadOnlyList<PayrollResult> _results = Array.Empty<PayrollResult>();
	private PayrollRun? _selectedRun;
	private PayrollResult? _selectedResult;
	private IReadOnlyList<PayrollResultDetail> _details = Array.Empty<PayrollResultDetail>();
	private IReadOnlyList<PayrollPayment> _payments = Array.Empty<PayrollPayment>();
	private IReadOnlyList<PayrollRunIssue> _issues = Array.Empty<PayrollRunIssue>();
	private PayrollRunEmployeeStats? _stats;
	private IReadOnlyList<PayrollRunEmployeeState> _runEmployees = Array.Empty<PayrollRunEmployeeState>();
	private bool _calculating;

	protected override string ScreenCode => ScreenCodes.PayrollRuns;

	protected override async Task OnLoadAsync() => _runs = await PayrollRuns.ListAsync();

	private async Task CreateAsync()
	{
		if (!DateOnly.TryParse(_salaryFrom, out var salaryFrom) ||
			!DateOnly.TryParse(_salaryTo, out var salaryTo) ||
			!DateOnly.TryParse(_variablesFrom, out var variablesFrom) ||
			!DateOnly.TryParse(_variablesTo, out var variablesTo))
		{
			Snackbar.Add("أدخل التواريخ بصيغة yyyy-MM-dd.", Severity.Error);
			return;
		}

		try
		{
			_createdRun = new PayrollRun
			{
				Id = Guid.NewGuid(),
				SalaryFrom = salaryFrom,
				SalaryTo = salaryTo,
				VariablesFrom = variablesFrom,
				VariablesTo = variablesTo,
				CutoffAt = _cutoff?.ToUniversalTime()
			};
			await PayrollRuns.CreateAsync(_createdRun, Actor?.UserId);
			_runs = await PayrollRuns.ListAsync();
			Snackbar.Add("تم إنشاء دورة المرتبات.", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add(ex.Message, Severity.Error);
			_createdRun = null;
		}
	}

	private async Task CreateAdjustmentAsync()
	{
		if (_creatingAdjustment) return;
		if (!DateOnly.TryParse(_variablesFrom, out var variablesFrom) ||
			!DateOnly.TryParse(_variablesTo, out var variablesTo))
		{
			Snackbar.Add("أدخل فترة المتغيرات بصيغة yyyy-MM-dd.", Severity.Error);
			return;
		}

		_creatingAdjustment = true;
		try
		{
			var run = new PayrollRun
			{
				Id = Guid.NewGuid(), RunType = PayrollRunTypes.Adjustment,
				SourceRunId = _selectedRun?.Id,
				SalaryFrom = DateOnly.TryParse(_salaryFrom, out var salaryFrom) ? salaryFrom : variablesFrom,
				SalaryTo = DateOnly.TryParse(_salaryTo, out var salaryTo) ? salaryTo : variablesTo,
				VariablesFrom = variablesFrom, VariablesTo = variablesTo,
				CutoffAt = _cutoff?.ToUniversalTime()
			};
			await PayrollRuns.CreateAsync(run, Actor?.UserId);
			_runs = await PayrollRuns.ListAsync();
			Snackbar.Add("تم إنشاء دورة تسوية — تُحسب على حركات التسوية فقط بلا راتب أساسي.", Severity.Success);
		}
		catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
		finally { _creatingAdjustment = false; }
	}

	private async Task SelectResultAsync(PayrollResult result)
	{
		_selectedResult = result;
		_details = await PayrollRuns.ListResultDetailsAsync(result.Id);
	}

	private async Task CalculateRunAsync(PayrollRun run)
	{
		if (_calculating) return;
		_calculating = true;
		try
		{
			var summary = await PayrollCalculation.CalculateRunAsync(run.Id, $"ui-{DateTime.UtcNow:yyyyMMddHHmmss}", Actor);
			_runs = await PayrollRuns.ListAsync();
			Snackbar.Add($"تم حساب الدورة لـ {summary.CalculatedCount} موظف.", Severity.Success);
		}
		catch (Exception ex)
		{
			Snackbar.Add(ex.Message, Severity.Error);
			_runs = await PayrollRuns.ListAsync();
		}
		finally
		{
			_calculating = false;
		}
	}

	private async Task SelectRunAsync(PayrollRun run)
	{
		_selectedRun = run;
		_selectedResult = null;
		_details = Array.Empty<PayrollResultDetail>();
		_results = await PayrollRuns.ListResultsAsync(run.Id);
		_issues = await PayrollRuns.ListIssuesAsync(run.Id);
		_stats = await PayrollRuns.GetRunEmployeeStatsAsync(run.Id);
		_runEmployees = await PayrollRuns.ListRunEmployeesAsync(run.Id);
		_payments = await PayrollRuns.ListPaymentsAsync(run.Id);
	}

	private async Task PayAsync()
	{
		if (_selectedRun is null) return;
		try
		{
			var count = await PayrollRuns.PayRunAsync(_selectedRun.Id, "bank_transfer", Actor);
			_selectedRun = await PayrollRuns.GetAsync(_selectedRun.Id);
			_runs = await PayrollRuns.ListAsync();
			_payments = await PayrollRuns.ListPaymentsAsync(_selectedRun!.Id);
			Snackbar.Add($"تم صرف {count} دفعة.", Severity.Success);
		}
		catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
	}

	private async Task PostAsync()
	{
		if (_selectedRun is null || Actor?.UserId is not Guid userId) return;
		try
		{
			var count = await PayrollPosting.PostRunAsync(_selectedRun.Id, userId, Actor);
			_selectedRun = await PayrollRuns.GetAsync(_selectedRun.Id);
			_runs = await PayrollRuns.ListAsync();
			Snackbar.Add($"تم ترحيل {count} قيد مرتبات.", Severity.Success);
		}
		catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
	}

	private async Task TransitionAsync(string targetStatus)
	{
		if (_selectedRun is null) return;
		try
		{
			_selectedRun = await PayrollRuns.TransitionAsync(_selectedRun.Id, _selectedRun.Version,
				targetStatus, null, Actor);
			_issues = await PayrollRuns.ListIssuesAsync(_selectedRun.Id);
			_runs = await PayrollRuns.ListAsync();
			Snackbar.Add("تم تحديث حالة دورة المرتبات.", Severity.Success);
		}
		catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
	}

	private string _reopenReason = "";
	private Guid? _payEmployeeId;
	private string _payMethod = "bank_transfer";
	private decimal _payAmount;

	private async Task ReopenAsync()
	{
		if (_selectedRun is null || Actor is null) return;
		try
		{
			_selectedRun = await PayrollRuns.ReopenAsync(_selectedRun.Id, _selectedRun.Version,
				_reopenReason, Actor);
			_runs = await PayrollRuns.ListAsync();
			Snackbar.Add("تم إعادة فتح الدورة للحساب.", Severity.Success);
		}
		catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
	}

	private async Task PayEmployeeAsync()
	{
		if (_selectedRun is null || _payEmployeeId is not { } employeeId)
		{
			Snackbar.Add("اختر موظفاً للصرف.", Severity.Warning);
			return;
		}
		try
		{
			var paid = await PayrollRuns.PayEmployeeAsync(_selectedRun.Id, employeeId, _payMethod,
				_payAmount, Actor);
			_selectedRun = await PayrollRuns.GetAsync(_selectedRun.Id);
			_runs = await PayrollRuns.ListAsync();
			_payments = await PayrollRuns.ListPaymentsAsync(_selectedRun!.Id);
			Snackbar.Add($"تم صرف {paid:N2}", Severity.Success);
		}
		catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
	}
}
