@page "/system/user-manual"
@attribute [Authorize]
@inherits SecurePageBase
<PageTitle>@T.T("screen.user_manual")</PageTitle>

@if (Denied)
{
    <ForbiddenView />
}
else if (Loading)
{
    <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <PageHeader Title="@T.T("screen.user_manual")" Subtitle="@T.T("user_manual.hint")">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync"
                       Disabled="_busy">
                @T.T("user_manual.refresh")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync"
                       Disabled="_busy">
                @T.T("common.print")
            </MudButton>
        </Actions>
    </PageHeader>

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }

    @if (_updatedAt is { } updated)
    {
        <div class="ubp-manual-meta">
            <MudChip T="string" Size="Size.Small" Color="@(_generated ? Color.Success : Color.Default)"
                     Variant="Variant.Outlined">
                @T.T(_generated ? "user_manual.generated" : "user_manual.static_copy")
            </MudChip>
            <span>@T.T("user_manual.counts", _screenCount, _buttonCount, _tableCount)</span>
            <span>@T.T("user_manual.updated_at"): @updated.ToString("yyyy-MM-dd HH:mm")</span>
            @if (_screens.Count > 0)
            {
                <span>@T.T("user_manual.shot_count", _shotUrls.Count, _screens.Count)</span>
            }
            @if (!_schemaAvailable)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                    @T.T("user_manual.schema_unavailable")
                </MudChip>
            }
            @if (!_sourceAvailable)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                    @T.T("user_manual.source_unavailable")
                </MudChip>
            }
        </div>
    }

    @if (_missing)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @T.T("user_manual.missing")
        </MudAlert>
    }
    else if (_screens.Count == 0)
    {
        <MudPaper Elevation="0" Class="ubp-card ubp-manual">
            @((MarkupString)_html)
        </MudPaper>
    }
    else
    {
        <MudTabs Elevation="0" Rounded="true" PanelClass="pt-3" @bind-ActivePanelIndex="_tab">
            <MudTabPanel Text="@T.T("user_manual.gallery")" Icon="@Icons.Material.Filled.PhotoCamera">
                <div class="ubp-shot-toolbar">
                    <MudSelect T="string" Value="_group" ValueChanged="OnGroupChanged"
                               Label="@T.T("user_manual.group")" Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var group in _groups)
                        {
                            <MudSelectItem T="string" Value="@group.Key">@group.Value</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_search" Placeholder="@T.T("common.search")"
                                  Immediate="true" DebounceInterval="300"
                                  OnDebounceIntervalElapsed="OnSearchChanged"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(_capturing ? Color.Warning : Color.Primary)">
                        @T.T("user_manual.shots_loaded", _shotUrls.Count, _screens.Count)
                    </MudChip>
                </div>

                @if (_capturing)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
                    <MudText Typo="Typo.caption" Class="ubp-muted mb-3">@T.T("user_manual.capturing")</MudText>
                }

                @if (FilteredScreens.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @T.T("user_manual.no_results")
                    </MudAlert>
                }
                else
                {
                    @foreach (var screen in FilteredScreens)
                    {
                        <div class="ubp-shot-card">
                            <div class="ubp-shot-head">
                                <div>
                                    <strong>@screen.Title</strong>
                                </div>
                                <div class="ubp-shot-actions">
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.PhotoCamera"
                                               Disabled="_capturing" OnClick="() => CaptureAsync(screen)">
                                        @T.T("user_manual.capture")
                                    </MudButton>
                                    @if (_shotUrls.ContainsKey(screen.Code))
                                    {
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error" Disabled="_capturing"
                                                       OnClick="() => DeleteAsync(screen)" />
                                    }
                                </div>
                            </div>

                            @if (_shotUrls.TryGetValue(screen.Code, out var url))
                            {
                                <a class="ubp-shot-link" href="@url" target="_blank" rel="noopener">
                                    <img class="ubp-shot-image" src="@url" alt="@screen.Title" loading="lazy" />
                                </a>
                            }
                            else
                            {
                                @((MarkupString)ManualScreenIllustration.Render(screen))
                                <MudText Typo="Typo.caption" Class="ubp-shot-hint">
                                    @T.T("user_manual.illustration_hint")
                                </MudText>
                            }

                            <details class="ubp-shot-notes" open>
                                <summary>@T.T("user_manual.annotations")</summary>
                                <ol>
                                    @foreach (var annotation in ManualScreenshotAnnotations.Build(screen))
                                    {
                                        <li>@annotation.Text</li>
                                    }
                                </ol>
                            </details>

                            @{
                                var relatedDialogs = DialogsFor(screen);
                            }
                            @if (relatedDialogs.Count > 0)
                            {
                                <div class="ubp-dialog-section">
                                    <MudText Typo="Typo.subtitle2" Class="ubp-dialog-title">
                                        @T.T("user_manual.dialogs")
                                    </MudText>
                                    @foreach (var dialog in relatedDialogs)
                                    {
                                        var dialogCode = DialogCode(screen, dialog);
                                        var trigger = TriggerFor(screen, dialog);
                                        var hasDialogShot = _shotUrls.TryGetValue(dialogCode, out var dialogUrl);
                                        <div class="ubp-dialog-card">
                                            <div class="ubp-dialog-head">
                                                <div>
                                                    <strong>@DialogTitle(dialog)</strong>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                             Color="Color.Info">@dialog.Kind</MudChip>
                                                </div>
                                                <div class="ubp-shot-actions">
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                               Color="Color.Primary"
                                                               StartIcon="@Icons.Material.Filled.PhotoCamera"
                                                               Disabled="_capturing || string.IsNullOrWhiteSpace(trigger)"
                                                               OnClick="() => CaptureDialogAsync(screen, dialog)">
                                                        @T.T("user_manual.capture_dialog")
                                                    </MudButton>
                                                    @if (hasDialogShot)
                                                    {
                                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                                                       Color="Color.Error" Disabled="_capturing"
                                                                       OnClick="() => DeleteShotAsync(dialogCode)" />
                                                    }
                                                </div>
                                            </div>
                                            <MudText Typo="Typo.caption" Class="ubp-muted">@dialog.Purpose</MudText>
                                            <div class="ubp-dialog-shot">
                                                @if (hasDialogShot)
                                                {
                                                    <a class="ubp-shot-link" href="@dialogUrl" target="_blank" rel="noopener">
                                                        <img class="ubp-shot-image" src="@dialogUrl" alt="@DialogTitle(dialog)" loading="lazy" />
                                                    </a>
                                                }
                                                else
                                                {
                                                    @((MarkupString)ManualDialogIllustration.Render(dialog))
                                                }
                                            </div>
                                            <details class="ubp-shot-notes" open>
                                                <summary>@T.T("user_manual.dialog_usage")</summary>
                                                <div class="ubp-dialog-fields">
                                                    <strong>@T.T("user_manual.fields"):</strong>
                                                    @string.Join(" · ", dialog.Fields)
                                                </div>
                                                <div class="ubp-manual-table-wrap">
                                                    <table class="ubp-manual-table">
                                                        <thead>
                                                            <tr>
                                                                <th>@T.T("user_manual.button")</th>
                                                                <th>@T.T("user_manual.permission")</th>
                                                                <th>@T.T("user_manual.appears")</th>
                                                                <th>@T.T("user_manual.limits")</th>
                                                                <th>@T.T("user_manual.audit")</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var button in dialog.Buttons)
                                                            {
                                                                <tr>
                                                                    <td>@button.Label</td>
                                                                    <td>@ManualText.Permission(button.Permission)</td>
                                                                    <td>@ManualText.Simplify(button.Appears)</td>
                                                                    <td>@ManualText.Simplify(button.Limits)</td>
                                                                    <td>@ManualText.Audit(button.Audit)</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </details>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </MudTabPanel>
            <MudTabPanel Text="@T.T("user_manual.text_manual")" Icon="@Icons.Material.Filled.Article">
                <MudPaper Elevation="0" Class="ubp-card ubp-manual">
                    @((MarkupString)_html)
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
}
