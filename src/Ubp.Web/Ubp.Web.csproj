<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Ubp.Web</RootNamespace>
    <UserSecretsId>ubp-web-local-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ubp.Application\Ubp.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Resources\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\USER-MANUAL-AR.md" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\docs\USER-MANUAL-AR.md" Link="Resources\USER-MANUAL-AR.md" />
  </ItemGroup>

  <!-- مولّد دليل المستخدم يقرأ ملفات المصدر الحالية من مجلد Code في الإخراج/النشر. -->
  <Target Name="CopyManualSources" AfterTargets="Build">
    <ItemGroup>
      <ManualPageSources Include="Pages\**\*.razor" />
      <ManualPageCodeSources Include="Pages\**\*.razor.cs" />
      <ManualComponentSources Include="Components\**\*.razor" />
      <ManualComponentCodeSources Include="Components\**\*.razor.cs" />
      <ManualServiceSources Include="..\Ubp.Application\Services\*.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(ManualPageSources)" DestinationFiles="@(ManualPageSources->'$(OutDir)Code\Pages\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManualPageCodeSources)" DestinationFiles="@(ManualPageCodeSources->'$(OutDir)Code\Pages\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManualComponentSources)" DestinationFiles="@(ManualComponentSources->'$(OutDir)Code\Components\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManualComponentCodeSources)" DestinationFiles="@(ManualComponentCodeSources->'$(OutDir)Code\Components\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManualServiceSources)" DestinationFiles="@(ManualServiceSources->'$(OutDir)Code\Services\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyManualSourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ManualPageSourcesPublish Include="Pages\**\*.razor" />
      <ManualPageCodeSourcesPublish Include="Pages\**\*.razor.cs" />
      <ManualComponentSourcesPublish Include="Components\**\*.razor" />
      <ManualComponentCodeSourcesPublish Include="Components\**\*.razor.cs" />
      <ManualServiceSourcesPublish Include="..\Ubp.Application\Services\*.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(ManualPageSourcesPublish)" DestinationFiles="@(ManualPageSourcesPublish->'$(PublishDir)Code\Pages\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManualPageCodeSourcesPublish)" DestinationFiles="@(ManualPageCodeSourcesPublish->'$(PublishDir)Code\Pages\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManualComponentSourcesPublish)" DestinationFiles="@(ManualComponentSourcesPublish->'$(PublishDir)Code\Components\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManualComponentCodeSourcesPublish)" DestinationFiles="@(ManualComponentCodeSourcesPublish->'$(PublishDir)Code\Components\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManualServiceSourcesPublish)" DestinationFiles="@(ManualServiceSourcesPublish->'$(PublishDir)Code\Services\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
