-- Payroll phase 3: JSON optimization and metadata
-- Version V6.1 -- 21 November 2026

-- JSON column tracking
CREATE TABLE IF NOT EXISTS payroll_json_columns (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    table_name varchar(100) NOT NULL,
    column_name varchar(100) NOT NULL,
    json_path varchar(200),
    description text,
    data_type varchar(50),
    is_required boolean NOT NULL DEFAULT false,
    version integer NOT NULL DEFAULT 1,
    created_at timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS ix_payroll_json_columns_table ON payroll_json_columns (table_name);

-- Migration change log
CREATE TABLE IF NOT EXISTS payroll_migration_change_log (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    migration_script varchar(100) NOT NULL,
    company_id uuid,
    change_type varchar(30) NOT NULL, -- 'ADDED', 'MODIFIED', 'REMOVED'
    old_value text,
    new_value text,
    changed_at timestamptz NOT NULL DEFAULT now(),
    changed_by uuid REFERENCES users(id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS ix_payroll_migration_change_company ON payroll_migration_change_log (company_id);

