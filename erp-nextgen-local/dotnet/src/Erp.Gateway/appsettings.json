{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "erp-api-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "generic-data-route": {
        "ClusterId": "erp-api-cluster",
        "Match": { "Path": "/api/v1/generic/{**catch-all}" },
        "RateLimiterPolicy": "fixed-window-tenant"
      },
      "system-route": {
        "ClusterId": "erp-api-cluster",
        "Match": { "Path": "/api/v1/system/{**catch-all}" }
      },
      "openapi-route": {
        "ClusterId": "erp-api-cluster",
        "Match": { "Path": "/openapi/{**catch-all}" }
      }
    },
    "Clusters": {
      "erp-api-cluster": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}
